{
  "manual_call_templates": [
    {
      "name": "calculator",
      "call_template_type": "http",
      "url": "http://127.0.0.1:8080",
      "manual": {
        "manual_version": "1.0",
        "utcp_version": "1.1.0",
        "info": {
          "title": "Calculator",
          "version": "1.0.0"
        },
        "tools": [
      {
        "name": "add",
        "description": "Add two numbers.",
        "inputs": {
          "type": "object",
          "properties": {
            "a": { "type": "number" },
            "b": { "type": "number" }
          },
          "required": ["a", "b"]
        },
        "outputs": {
          "type": "object",
          "properties": { "result": { "type": "number" } },
          "required": ["result"]
        },
        "tool_call_template": {
          "call_template_type": "http",
          "url": "http://127.0.0.1:8080/add",
          "http_method": "POST",
          "body_fields": { "a": "{a}", "b": "{b}" }
        }
      },
      {
        "name": "multiply",
        "description": "Multiply two numbers.",
        "inputs": {
          "type": "object",
          "properties": {
            "a": { "type": "number" },
            "b": { "type": "number" }
          },
          "required": ["a", "b"]
        },
        "outputs": {
          "type": "object",
          "properties": { "result": { "type": "number" } },
          "required": ["result"]
        },
        "tool_call_template": {
          "call_template_type": "http",
          "url": "http://127.0.0.1:8080/multiply",
          "http_method": "POST",
          "body_fields": { "a": "{a}", "b": "{b}" }
        }
      }
        ]
      }
    },
    {
      "name": "filesystem",
      "call_template_type": "cli",
      "manual": {
        "manual_version": "1.0",
        "utcp_version": "1.1.0",
        "info": {
          "title": "Filesystem",
          "version": "1.0.0"
        },
        "tools": [
      {
        "name": "read",
        "description": "Read an existing file from the workspace without modifying it.",
        "inputs": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Existing file path relative to the workspace root."
            }
          },
          "required": ["path"],
          "additionalProperties": false
        },
        "outputs": {
          "type": "string",
          "description": "The complete UTF-8 contents of the requested file."
        },
        "tool_call_template": {
          "call_template_type": "cli",
          "commands": [
            { "command": "go-harness-filesystem --root . filesystem.read UTCP_ARG_JSON_UTCP_END" }
          ],
          "working_dir": ".",
          "output_type": "text"
        }
      },
      {
        "name": "write",
        "description": "Create a new file in the workspace. Do not use this tool to modify an existing file.",
        "inputs": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path for the new file relative to the workspace root."
            },
            "content": {
              "type": "string",
              "description": "Complete initial content of the new file."
            }
          },
          "required": ["path", "content"],
          "additionalProperties": false
        },
        "outputs": {
          "type": "string",
          "description": "CLI result returned after creating the file."
        },
        "tool_call_template": {
          "call_template_type": "cli",
          "commands": [
            { "command": "go-harness-filesystem --root . filesystem.write UTCP_ARG_JSON_UTCP_END" }
          ],
          "working_dir": ".",
          "output_type": "text"
        }
      },
      {
        "name": "diff.unified",
        "description": "Compute a valid unified diff between original and replacement text. Hunk headers and line counts are derived deterministically from the input strings; callers must not hand-author unified diff hunks themselves.",
        "inputs": {
          "type": "object",
          "properties": {
            "original": {
              "type": "string",
              "description": "The complete original file content."
            },
            "replacement": {
              "type": "string",
              "description": "The complete replacement file content."
            },
            "path": {
              "type": "string",
              "description": "File path used in the diff's --- a/<path> and +++ b/<path> headers. Defaults to \"README.md\" if omitted."
            },
            "context_size": {
              "type": "integer",
              "description": "Number of unchanged context lines to include around each hunk. Defaults to 3."
            }
          },
          "required": ["original", "replacement"],
          "additionalProperties": false
        },
        "outputs": {
          "type": "string",
          "description": "A valid unified diff patch that can be passed directly to filesystem.patch."
        },
        "tool_call_template": {
          "call_template_type": "cli",
          "commands": [
            { "command": "go-harness-filesystem --root . diff.unified UTCP_ARG_JSON_UTCP_END" }
          ],
          "working_dir": ".",
          "output_type": "text"
        }
      },
      {
        "name": "patch",
        "description": "Apply a unified diff patch to existing files in the workspace.",
        "inputs": {
          "type": "object",
          "properties": {
            "patch": {
              "type": "string",
              "description": "Unified diff patch to apply to existing files."
            }
          },
          "required": ["patch"],
          "additionalProperties": false
        },
        "outputs": {
          "type": "string",
          "description": "CLI result returned after applying the patch."
        },
        "tool_call_template": {
          "call_template_type": "cli",
          "commands": [
            { "command": "go-harness-filesystem --root . filesystem.patch UTCP_ARG_JSON_UTCP_END" }
          ],
          "working_dir": ".",
          "output_type": "text"
        }
      }
        ]
      }
    }
  ]
}
