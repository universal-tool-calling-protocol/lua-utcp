{
  "name": "calculator",
  "call_template_type": "http",
  "url": "http://127.0.0.1:8080",
  "manual": {
    "manual_version": "1.0",
    "utcp_version": "1.0",
    "tools": [
      {
        "name": "add",
        "description": "Add two numbers.",
        "inputs": {
          "type": "object",
          "properties": {
            "a": { "type": "number" },
            "b": { "type": "number" }
          },
          "required": ["a", "b"]
        },
        "outputs": {
          "type": "object",
          "properties": { "result": { "type": "number" } },
          "required": ["result"]
        },
        "tool_call_template": {
          "call_template_type": "http",
          "url": "http://127.0.0.1:8080/add",
          "http_method": "POST",
          "body_fields": { "a": "{a}", "b": "{b}" }
        }
      },
      {
        "name": "multiply",
        "description": "Multiply two numbers.",
        "inputs": {
          "type": "object",
          "properties": {
            "a": { "type": "number" },
            "b": { "type": "number" }
          },
          "required": ["a", "b"]
        },
        "outputs": {
          "type": "object",
          "properties": { "result": { "type": "number" } },
          "required": ["result"]
        },
        "tool_call_template": {
          "call_template_type": "http",
          "url": "http://127.0.0.1:8080/multiply",
          "http_method": "POST",
          "body_fields": { "a": "{a}", "b": "{b}" }
        }
      },
      {
        "name": "filesystem.read",
        "description": "Read an existing file from the workspace without modifying it.",
        "inputs": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Existing file path relative to the workspace root."
            }
          },
          "required": ["path"],
          "additionalProperties": false
        },
        "outputs": {
          "type": "string",
          "description": "The complete UTF-8 contents of the requested file."
        },
        "tool_call_template": {
          "call_template_type": "cli",
          "commands": [
            { "command": "go-harness-filesystem --root . filesystem.read UTCP_ARG_JSON_UTCP_END" }
          ],
          "working_dir": ".",
          "output_type": "text"
        }
      },
      {
        "name": "filesystem.write",
        "description": "Create a new file in the workspace. Do not use this tool to modify an existing file.",
        "inputs": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path for the new file relative to the workspace root."
            },
            "content": {
              "type": "string",
              "description": "Complete initial content of the new file."
            }
          },
          "required": ["path", "content"],
          "additionalProperties": false
        },
        "outputs": {
          "type": "string",
          "description": "CLI result returned after creating the file."
        },
        "tool_call_template": {
          "call_template_type": "cli",
          "commands": [
            { "command": "go-harness-filesystem --root . filesystem.write UTCP_ARG_JSON_UTCP_END" }
          ],
          "working_dir": ".",
          "output_type": "text"
        }
      },
      {
        "name": "filesystem.patch",
        "description": "Apply a unified diff patch to existing files in the workspace.",
        "inputs": {
          "type": "object",
          "properties": {
            "patch": {
              "type": "string",
              "description": "Unified diff patch to apply to existing files."
            }
          },
          "required": ["patch"],
          "additionalProperties": false
        },
        "outputs": {
          "type": "string",
          "description": "CLI result returned after applying the patch."
        },
        "tool_call_template": {
          "call_template_type": "cli",
          "commands": [
            { "command": "go-harness-filesystem --root . filesystem.patch UTCP_ARG_JSON_UTCP_END" }
          ],
          "working_dir": ".",
          "output_type": "text"
        }
      }
    ]
  }
}
